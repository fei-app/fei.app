<?xml version="1.0" encoding="utf-8"?>
<!--
    Tela offline global (tela cheia: ícone, "Sem internet" e botão de tentar novamente).

    Uso:
        <include
            android:id="@+id/layout_sem_internet"
            layout="@layout/include_offline_screen"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone" />

    - O id do root é definido em cada <include> (R.id.layout_sem_internet).
    - O botão interno mantém o id @+id/btn_tentar_novamente.
    - Fundo opaco (@color/fundocartao) para cobrir o conteúdo por baixo.
    - paddingBottom = actionBarSize compensa a barra de navegação inferior (centro óptico).
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/fundocartao"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="24dp"
    android:paddingBottom="?attr/actionBarSize"
    android:visibility="gone">

    <ImageView
        android:layout_width="64dp"
        android:layout_height="64dp"
        android:contentDescription="@string/sem_conexao_internet"
        android:src="@drawable/ic_sem_internet"
        app:tint="?attr/colorOnSurface" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="@string/sem_conexao_internet"
        android:textAppearance="@style/TextAppearance.MaterialComponents.Headline6" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_tentar_novamente"
        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:text="@string/try_again" />
</LinearLayout>
