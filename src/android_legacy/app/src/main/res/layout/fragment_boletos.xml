<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/fundocartao">

    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <!-- Barra Offline (global: layout/include_offline_bar.xml) -->
        <include
            android:id="@+id/barOffline"
            layout="@layout/include_offline_bar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <!-- Banner AdMob (Abaixo da barra offline) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:paddingTop="8dp"
            android:paddingBottom="4dp">
        </LinearLayout>

        <!-- Texto de estado vazio -->
        <TextView
            android:id="@+id/txt_sem_dados"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:text="@string/nenhum_boleto_disponivel"
            android:textAppearance="?attr/textAppearanceBodyLarge"
            android:padding="24dp"
            android:visibility="gone"/>

        <!-- Lista de boletos -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recyclerBoletos"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingTop="8dp"
            android:paddingBottom="16dp"
            android:visibility="gone"/>

    </LinearLayout>

    <!-- Loading (global: layout/include_loading.xml) -->
    <include
        android:id="@+id/progress_circular"
        layout="@layout/include_loading"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone" />

</androidx.coordinatorlayout.widget.CoordinatorLayout>
