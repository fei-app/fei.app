<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/fundocartao">

    <!-- Container principal mantendo orientação horizontal -->
    <LinearLayout
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <!-- Painel esquerdo: cópia exata do layout de celular -->
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1">
            <!-- Barra Offline (global: layout/include_offline_bar.xml) -->
            <include
                android:id="@+id/barOffline"
                layout="@layout/include_offline_bar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <!-- Spinner + Filtro -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_margin="16dp"
                android:gravity="center_vertical">

                <!-- Mes Spinner -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    app:cardCornerRadius="8dp"
                    app:cardElevation="2dp"
                    app:cardBackgroundColor="@color/fundocartao">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:paddingEnd="12dp"
                        android:gravity="center_vertical"
                        tools:ignore="RtlSymmetry">

                        <Spinner
                            android:id="@+id/spinner_mes"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:background="@android:color/transparent"
                            android:padding="12dp"/>

                        <ImageView
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:importantForAccessibility="no"
                            android:src="@drawable/ic_arrow_drop_down"
                            app:tint="?attr/colorOnSurface" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Botão de filtro -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_marginStart="8dp"
                    app:cardCornerRadius="8dp"
                    app:cardElevation="0dp"
                    app:strokeColor="@color/fundocartao"
                    app:cardBackgroundColor="@color/fundocartao">

                    <ImageButton
                        android:id="@+id/btnFiltro"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:src="@drawable/ic_filtro"
                        android:contentDescription="@string/filtrar_provas"
                        app:tint="?attr/colorOnSurface" />
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>

            <!-- Mensagens e Lista -->
            <TextView
                android:id="@+id/txt_sem_provas"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="@string/sem_provas_esse_mes"
                android:textAppearance="?attr/textAppearanceBodyLarge"
                android:visibility="gone"
                android:padding="24dp"/>

            <TextView
                android:id="@+id/txt_sem_dados"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="@string/sem_dados"
                android:textAppearance="?attr/textAppearanceBodyLarge"
                android:visibility="gone"
                android:padding="24dp"/>

            <!-- Lista de provas + Loading global (sobrepostos na área da lista) -->
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                tools:ignore="NestedWeights">

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/recyclerProvas"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:clipToPadding="false"
                    android:paddingBottom="16dp" />

                <!-- Loading (global: layout/include_loading.xml) -->
                <include
                    android:id="@+id/progress_circular"
                    layout="@layout/include_loading"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:visibility="gone" />
            </FrameLayout>
        </LinearLayout>

        <!-- Divisor -->
        <View
            android:layout_width="1dp"
            android:layout_height="match_parent"
            android:background="@color/fundocartao" />

        <!-- Painel direito: Conteúdo da prova selecionada COM BANNER ADMOB NO TOPO -->
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="2">

            <!-- Banner AdMob Fixo no topo direito -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:paddingTop="8dp"
                android:paddingBottom="8dp">
            </LinearLayout>

            <FrameLayout
                android:id="@+id/detail_container"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                tools:ignore="NestedWeights">

                <!-- Placeholder inicial -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:text="@string/selecione_uma_prova"
                    android:textColor="?attr/colorOnSurface"/>
            </FrameLayout>

        </LinearLayout>
    </LinearLayout>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
