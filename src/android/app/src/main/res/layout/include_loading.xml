<?xml version="1.0" encoding="utf-8"?>
<!--
    Tela/overlay de carregamento global (design do NotasFragment):
    indicador circular 48dp + texto "Carregando…" centralizados.

    Uso:
        <include
            android:id="@+id/loadingContainer"   (ou progress_circular, progressBar, loading_container…)
            layout="@layout/include_loading"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone" />          (ou visible, se deve iniciar visível)

    - O id do root é definido em cada <include>; o Kotlin controla via .visibility.
    - O texto interno mantém o id @+id/txtStuckHint (usado pelo HomeFragment).
    - Fundo transparente: herda o fundo do pai (@color/fundocartao em todas as telas).
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:visibility="gone">

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        tools:ignore="UselessParent">

        <com.google.android.material.progressindicator.CircularProgressIndicator
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:indeterminate="true"
            app:indicatorColor="?attr/colorPrimary"
            app:trackColor="?attr/colorSurfaceVariant" />

        <TextView
            android:id="@+id/txtStuckHint"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/loading"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:textSize="14sp" />
    </LinearLayout>
</FrameLayout>
