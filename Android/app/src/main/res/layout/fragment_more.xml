<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/fundocartao">

    <LinearLayout
        android:id="@+id/content_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <LinearLayout
            android:id="@+id/profile_section"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="20dp"
            android:background="@color/fundocartao"
            android:gravity="center_vertical">

            <!-- Foto de Perfil -->
            <com.google.android.material.imageview.ShapeableImageView
                android:id="@+id/iv_profile_photo"
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:src="@drawable/ic_person"
                android:contentDescription="@string/foto_de_perfil"
                android:layout_marginEnd="16dp"
                app:shapeAppearanceOverlay="@style/CircleImageView"
                android:background="@color/white"
                app:strokeColor="?attr/colorOutline"
                app:strokeWidth="1dp" />

            <!-- Informações do Usuário -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <!-- Nome do Aluno -->
                <TextView
                    android:id="@+id/tv_student_name"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/perfil_sem_dados"
                    android:textAppearance="?attr/textAppearanceHeadline6"
                    android:textStyle="bold"
                    android:layout_marginBottom="4dp" />

                <!-- Matrícula -->
                <TextView
                    android:id="@+id/tv_student_registration"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/sem_valor"
                    android:textAppearance="?attr/textAppearanceBody2"
                    android:textColor="?attr/colorOnSurfaceVariant"
                    android:layout_marginBottom="2dp" />

                <!-- Curso -->
                <TextView
                    android:id="@+id/tv_student_class"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/sem_valor"
                    android:textAppearance="?attr/textAppearanceBody2"
                    android:textColor="?attr/colorOnSurfaceVariant" />

                <!-- Email -->
                <TextView
                    android:id="@+id/tv_student_number"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/sem_valor"
                    android:textAppearance="?attr/textAppearanceBody2"
                    android:textColor="?attr/colorOnSurfaceVariant" />
            </LinearLayout>

            <!-- Botão de Info -->
            <ImageView
                android:id="@+id/btn_reload_profile"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:src="@drawable/ic_info"
                android:contentDescription="@string/recarregar_perfil"
                android:padding="4dp"
                android:clickable="true"
                android:focusable="true"
                app:tint="?attr/colorOnSurface" />
        </LinearLayout>

        <!-- Divisor -->
        <View
            android:id="@+id/divider"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="?android:attr/listDivider"
            android:layout_marginHorizontal="16dp"/>

        <androidx.core.widget.NestedScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true"
            app:layout_behavior="@string/appbar_scrolling_view_behavior">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingHorizontal="16dp"
                android:paddingTop="8dp"
                android:paddingBottom="100dp">

                <!-- Faltas -->
                <LinearLayout
                    android:id="@+id/option_faltas"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:paddingVertical="16dp"
                    android:paddingHorizontal="12dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:background="?android:attr/selectableItemBackground">

                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:src="@drawable/ic_faltas"
                        android:contentDescription="@string/faltas"
                        android:layout_marginEnd="16dp"
                        app:tint="?attr/colorOnSurface" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/faltas"
                        android:textAppearance="?android:attr/textAppearanceListItem" />
                </LinearLayout>

                <!-- Mudança de Horário -->
                <LinearLayout
                    android:id="@+id/option_mudanca_horario"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:paddingVertical="16dp"
                    android:paddingHorizontal="12dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:background="?android:attr/selectableItemBackground">

                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:src="@drawable/ic_horarios"
                        android:contentDescription="@string/mudan_a_de_hor_rio"
                        android:layout_marginEnd="16dp"
                        app:tint="?attr/colorOnSurface" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/mudan_a_de_hor_rio"
                        android:textAppearance="?android:attr/textAppearanceListItem" />
                </LinearLayout>

                <!-- Escolha de Área e Ênfase -->
                <LinearLayout
                    android:id="@+id/option_escolha_area"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:paddingVertical="16dp"
                    android:paddingHorizontal="12dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:background="?android:attr/selectableItemBackground">

                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:src="@drawable/ic_escolha_area"
                        android:contentDescription="@string/escolha_de_rea_e_nfase"
                        android:layout_marginEnd="16dp"
                        app:tint="?attr/colorOnSurface" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/escolha_de_rea_e_nfase"
                        android:textAppearance="?android:attr/textAppearanceListItem" />
                </LinearLayout>

                <!-- Dados Pessoais -->
                <LinearLayout
                    android:id="@+id/option_dados_pessoais"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:paddingVertical="16dp"
                    android:paddingHorizontal="12dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:background="?android:attr/selectableItemBackground">

                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:src="@drawable/ic_person"
                        android:contentDescription="@string/dados_pessoais"
                        android:layout_marginEnd="16dp"
                        app:tint="?attr/colorOnSurface" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/dados_pessoais"
                        android:textAppearance="?android:attr/textAppearanceListItem" />
                </LinearLayout>

                <!-- Atualização de Senha -->
                <LinearLayout
                    android:id="@+id/option_alterar_senha"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:paddingVertical="16dp"
                    android:paddingHorizontal="12dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:background="?android:attr/selectableItemBackground">

                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:src="@drawable/ic_chave"
                        android:contentDescription="@string/atualiza_o_de_senha"
                        android:layout_marginEnd="16dp"
                        app:tint="?attr/colorOnSurface" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/atualiza_o_de_senha"
                        android:textAppearance="?android:attr/textAppearanceListItem" />
                </LinearLayout>

                <!-- Boletos -->
                <LinearLayout
                    android:id="@+id/option_boletos"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:paddingVertical="16dp"
                    android:paddingHorizontal="12dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:background="?android:attr/selectableItemBackground">

                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:src="@drawable/ic_boleto"
                        android:contentDescription="@string/boletos"
                        android:layout_marginEnd="16dp"
                        app:tint="?attr/colorOnSurface" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/boletos"
                        android:textAppearance="?android:attr/textAppearanceListItem" />
                </LinearLayout>

                <!-- Presença -->
                <LinearLayout
                    android:id="@+id/option_persenca"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:paddingVertical="16dp"
                    android:paddingHorizontal="12dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:background="?android:attr/selectableItemBackground">

                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:src="@drawable/ic_presenca"
                        android:contentDescription="@string/presen_a"
                        android:layout_marginEnd="16dp"
                        app:tint="?attr/colorOnSurface" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/presen_a"
                        android:textAppearance="?android:attr/textAppearanceListItem" />
                </LinearLayout>

                <!-- Solicitação de Documentos -->
                <LinearLayout
                    android:id="@+id/option_solicitacao_documentos"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:paddingVertical="16dp"
                    android:paddingHorizontal="12dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:background="?android:attr/selectableItemBackground">

                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:src="@drawable/ic_documento"
                        android:contentDescription="@string/solicita_o_de_documentos"
                        android:layout_marginEnd="16dp"
                        app:tint="?attr/colorOnSurface" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/solicita_o_de_documentos"
                        android:textAppearance="?android:attr/textAppearanceListItem" />
                </LinearLayout>
                <!-- Atividades Complementares -->
                <LinearLayout
                    android:id="@+id/option_atividades_complementares"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:paddingVertical="16dp"
                    android:paddingHorizontal="12dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:background="?android:attr/selectableItemBackground">

                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:src="@drawable/ic_documento"
                        android:contentDescription="@string/atividades_complementares"
                        android:layout_marginEnd="16dp"
                        app:tint="?attr/colorOnSurface" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/atividades_complementares"
                        android:textAppearance="?android:attr/textAppearanceListItem" />
                </LinearLayout>
                <!-- Cursos de Férias -->
                <LinearLayout
                    android:id="@+id/option_curso_de_ferias"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:paddingVertical="16dp"
                    android:paddingHorizontal="12dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:background="?android:attr/selectableItemBackground">

                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:src="@drawable/ic_ferias"
                        android:contentDescription="@string/cursos_de_f_rias"
                        android:layout_marginEnd="16dp"
                        app:tint="?attr/colorOnSurface" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/cursos_de_f_rias"
                        android:textAppearance="?android:attr/textAppearanceListItem" />
                </LinearLayout>
                <!-- Site completo -->
                <LinearLayout
                    android:id="@+id/option_site_completo"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:paddingVertical="16dp"
                    android:paddingHorizontal="12dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:background="?android:attr/selectableItemBackground">

                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:src="@drawable/ic_site"
                        android:contentDescription="@string/site_completo"
                        android:layout_marginEnd="16dp"
                        app:tint="?attr/colorOnSurface" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/site_completo"
                        android:textAppearance="?android:attr/textAppearanceListItem" />
                </LinearLayout>

            </LinearLayout>
        </androidx.core.widget.NestedScrollView>

    </LinearLayout>

</androidx.coordinatorlayout.widget.CoordinatorLayout>